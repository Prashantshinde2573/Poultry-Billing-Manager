# Supabase project (Settings → API). The URL and anon/publishable key are public by design;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://yfefimkuiuqoqkzfggqt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3_YkE6-N_i52cQIDKMWxPw_iADRaApE

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used solely by the Owner-only
# "add staff / driver login" server action to create login accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Internal email domain used for mobile-number logins (drivers/staff without email).
LOGIN_EMAIL_DOMAIN=phone.poulgo.local

# Emails allowed to create the first super admin at /admin/login (comma separated)
SUPER_ADMIN_EMAILS=

# Razorpay (online plan renewal). Dashboard → Account & Settings → API Keys.
# The key id is public; the secret and webhook secret are SERVER ONLY.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<your-domain>/api/razorpay/webhook, events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# "Ask" AI chat (Google Gemini). Server only — never NEXT_PUBLIC_.
GEMINI_API_KEY=
# optional, defaults to gemini-3.6-flash
GEMINI_MODEL=
