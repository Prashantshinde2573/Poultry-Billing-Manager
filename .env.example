# URL of your deployed Google Apps Script Web App (ends with /exec).
# This URL is NOT a secret and NOT a security boundary — every request is
# authenticated with a username/password session token (see README §Security).
# Never put passwords, tokens or the spreadsheet ID in VITE_ variables:
# everything prefixed VITE_ is bundled into public JavaScript.
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
